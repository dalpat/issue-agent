#!/usr/bin/env bash

set -e

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
prompt_template="${script_dir}/agent-once-prompt.md"
progress="${script_dir}/progress.md"

show_version() {
  local version_file="${script_dir}/VERSION"
  if [ -f "$version_file" ]; then
    echo "issue-agent $(cat "$version_file")"
  else
    echo "issue-agent (version unknown)"
  fi
}

show_help() {
  show_version
  echo ""
  echo "Usage: $0 <issue-number>"
  echo ""
  echo "Work on exactly one GitHub issue. Retries up to 3 times on failure."
  echo "Manages issue labels automatically (in-progress → completed/failed)."
  echo ""
  echo "Arguments:"
  echo "  <issue-number>  GitHub issue number to work on"
  echo ""
  echo "Options:"
  echo "  --help          Show this help message"
  echo "  --version       Show version number"
  echo ""
  echo "Exit codes:"
  echo "  0  Issue completed successfully"
  echo "  1  Issue failed after 3 retries"
}

case "${1:-}" in
  --version) show_version; exit 0 ;;
  --help)    show_help; exit 0 ;;
esac

require_cmd() {
  local cmd="$1"
  local hint="$2"

  if ! command -v "$cmd" >/dev/null 2>&1; then
    echo "Error: Missing required command '$cmd'. $hint" >&2
    exit 1
  fi
}

require_cmd gh "Install GitHub CLI and authenticate with 'gh auth login' before running .agent/agent-once."
require_cmd opencode "Install the opencode CLI before running .agent/agent-once."

if [ -z "$1" ]; then
  echo "Usage: $0 <issue-number>"
  exit 1
fi

issue="$1"
max_retries=3
rendered_prompt=$(mktemp)

cleanup() {
  rm -f "$rendered_prompt"
}
trap cleanup EXIT

sed "s/__ISSUE_NUMBER__/$issue/g" "$prompt_template" > "$rendered_prompt"

echo "=== Agent-Once: Issue #$issue ==="
echo "Started: $(date '+%H:%M:%S')"
echo ""

# Add in-progress label
echo "Marking issue #$issue as in-progress..."
gh issue edit "$issue" --add-label "in-progress" 2>/dev/null || {
  # Create label if it doesn't exist
  gh label create "in-progress" --description "Agent is working on this" --color "FFA500" 2>/dev/null || true
  gh issue edit "$issue" --add-label "in-progress"
}

# Try up to max_retries times
for ((retry=1; retry<=max_retries; retry++)); do
  echo "--- Attempt $retry/$max_retries ---"
  
  tmpfile=$(mktemp)
  set +e
  opencode run -f "$progress" --dangerously-skip-permissions < "$rendered_prompt" 2>&1 | tee "$tmpfile"
  run_exit=${PIPESTATUS[0]}
  set -e
  result=$(cat "$tmpfile")
  rm -f "$tmpfile"
  
  if [ $run_exit -eq 0 ] && echo "$result" | grep -q '<promise>COMPLETE</promise>'; then
    echo ""
    echo "[SUCCESS] Issue #$issue completed"
    
    # Mark as completed
    gh issue edit "$issue" --add-label "completed" --remove-label "in-progress" 2>/dev/null || {
      gh label create "completed" --description "Agent completed this" --color "0E8A16" 2>/dev/null || true
      gh issue edit "$issue" --add-label "completed" --remove-label "in-progress"
    }
    
    echo "Issue #$issue completed at $(date '+%H:%M:%S')" >> "$progress"
    exit 0
  fi
  
  echo ""
  echo "[RETRY] Attempt $retry failed, retrying..."
  sleep 2
done

echo ""
echo "[FAILED] Issue #$issue failed after $max_retries attempts"

# Mark as failed
gh issue edit "$issue" --add-label "failed" --remove-label "in-progress" 2>/dev/null || {
  gh label create "failed" --description "Agent failed on this" --color "D73A4A" 2>/dev/null || true
  gh issue edit "$issue" --add-label "failed" --remove-label "in-progress"
}

echo "Issue #$issue failed at $(date '+%H:%M:%S')" >> "$progress"
exit 1
