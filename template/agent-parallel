#!/usr/bin/env bash

set -e

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
agent_once="${script_dir}/agent-once"
final_state=""
final_details=""

# Maximum seconds to allow a single agent-once run; override via AGENT_TIMEOUT env var
AGENT_TIMEOUT="${AGENT_TIMEOUT:-3600}"

show_version() {
  local version_file="${script_dir}/VERSION"
  if [ -f "$version_file" ]; then
    echo "issue-agent $(cat "$version_file")"
  else
    echo "issue-agent (version unknown)"
  fi
}

show_help() {
  show_version
  echo ""
  echo "Usage: $0 [--dry-run]"
  echo ""
  echo "Orchestrate parallel issue resolution. Auto-detects which issues"
  echo "can run simultaneously based on file overlap and blocker dependencies."
  echo ""
  echo "Options:"
  echo "  --dry-run       Show what would run without spawning agents"
  echo "  --help          Show this help message"
  echo "  --version       Show version number"
  echo ""
  echo "Environment variables:"
  echo "  AGENT_TIMEOUT   Max seconds per agent-once run (default: 3600)"
  echo ""
  echo "Exit codes:"
  echo "  0  All issues complete or dry run finished"
  echo "  1  Failed issues remain open"
  echo "  2  Issues still in progress elsewhere"
  echo "  3  Issues remain but none are schedulable"
}

# Handle --help and --version before requiring external commands
for arg in "$@"; do
  case "$arg" in
    --version) show_version; exit 0 ;;
    --help)    show_help; exit 0 ;;
  esac
done

require_cmd() {
  local cmd="$1"
  local hint="$2"

  if ! command -v "$cmd" >/dev/null 2>&1; then
    echo "Error: Missing required command '$cmd'. $hint" >&2
    exit 1
  fi
}

format_issue_list() {
  local issues="$1"
  echo "$issues" | tr '\n' ' ' | xargs 2>/dev/null || true
}

open_child_issues_json() {
  gh issue list --state open --json number,title,labels --limit 100 | jq '
    [
      .[] |
      select(
        (.labels | map(.name) |
          (contains(["PRD"]) or contains(["epic"]) or contains(["parent"])) | not
        )
      )
    ]
  '
}

issue_numbers_with_label() {
  local issues_json="$1"
  local label="$2"

  echo "$issues_json" | jq -r --arg label "$label" '
    .[] |
    select(.labels | map(.name) | contains([$label])) |
    .number
  '
}

require_cmd gh "Install GitHub CLI and authenticate with 'gh auth login' before running .agent/agent-parallel."
require_cmd jq "Install jq before running .agent/agent-parallel."
require_cmd opencode "Install the opencode CLI before running .agent/agent-parallel."

# Parse command line args
dry_run=false
if [[ "$1" == "--dry-run" ]]; then
  dry_run=true
  echo "=== DRY RUN MODE ==="
  echo ""
fi

echo "=== Agent Parallel ==="
echo "Started: $(date '+%H:%M:%S')"
echo ""

# Helper: Parse files from issue body
parse_files() {
  local issue_body="$1"
  local section="$2"  # "Existing files to modify" or "New files"
  
  # Extract lines between section header and next ## header
  echo "$issue_body" | awk -v section="$section" '
    $0 ~ "## " section {flag=1; next}
    flag && /^## / {flag=0}
    flag && /^- `/ {
      gsub(/^- `/, "")
      gsub(/`.*$/, "")
      print
    }
  '
}

# Helper: Check if issue is blocked
# Reads from global __ia_issue_states (populated once per iteration)
is_blocked() {
  local issue_body="$1"
  
  # Extract blocker issue numbers from "## Blocked by" section
  # Format: "- #14 (description)" or "- Blocked by #14"
  local blockers=$(echo "$issue_body" | awk '
    /^## Blocked by/ {flag=1; next}
    flag && /^## / {flag=0}
    flag && /^- / {
      if (match($0, /#[0-9]+/)) {
        print substr($0, RSTART+1, RLENGTH-1)
      }
    }
  ')
  
  for blocker in $blockers; do
    local blocker_state="${__ia_issue_states[$blocker]:-unknown}"
    if [ "$blocker_state" != "closed" ]; then
      return 0  # true, is blocked
    fi
  done
  
  return 1  # false, not blocked
}

# Helper: Check if two file sets overlap
files_overlap() {
  local files1="$1"
  local files2="$2"
  local -A seen_files=()
  local file_path=""

  while IFS= read -r file_path; do
    [ -z "$file_path" ] && continue
    seen_files["$file_path"]=1
  done <<< "$files1"

  while IFS= read -r file_path; do
    [ -z "$file_path" ] && continue
    if [ "${seen_files[$file_path]:-}" = "1" ]; then
      return 0  # true, overlap
    fi
  done <<< "$files2"

  return 1  # false, no overlap
}

iteration=1
while true; do
  echo ""
  echo "========================================"
  echo "Iteration $iteration"
  echo "========================================"
  
  # Fetch all open child issues (exclude parent PRD)
  echo "Fetching open issues..."
  issues_json=$(open_child_issues_json)
  open_issue_count=$(echo "$issues_json" | jq 'length')
  failed_issues=$(issue_numbers_with_label "$issues_json" "failed")
  in_progress_issues=$(issue_numbers_with_label "$issues_json" "in-progress")

  # Cache all issue states in one bulk fetch to avoid N+1 API calls in is_blocked()
  unset __ia_issue_states
  declare -A __ia_issue_states
  while IFS=$'\t' read -r num state; do
    [ -z "$num" ] && continue
    __ia_issue_states["$num"]="$state"
  done < <(gh issue list --state all --limit 200 --json number,state 2>/dev/null | jq -r '.[] | [(.number | tostring), .state] | @tsv')
  
  # Filter out parent PRD and issues with terminal or active labels
  available_issues=$(echo "$issues_json" | jq -r '
    .[] | 
    select(
      (.labels | map(.name) | 
        (contains(["in-progress"]) or contains(["completed"]) or contains(["failed"])) | not)
    ) | 
    .number
  ')
  
  if [ "$open_issue_count" -eq 0 ]; then
    final_state="complete"
    break
  fi

  if [ -z "$available_issues" ]; then
    if [ -n "$failed_issues" ]; then
      final_state="failed"
      final_details=$(format_issue_list "$failed_issues")
      echo "No schedulable issues remain. Failed issues still open: $final_details"
    elif [ -n "$in_progress_issues" ]; then
      final_state="in-progress"
      final_details=$(format_issue_list "$in_progress_issues")
      echo "No schedulable issues remain. In-progress issues still open: $final_details"
    else
      final_state="blocked"
      final_details=$(format_issue_list "$(echo "$issues_json" | jq -r '.[].number')")
      echo "No schedulable issues remain. Open child issues are blocked or waiting on dependencies: $final_details"
    fi
    break
  fi
  
  echo "Available issues: $available_issues"
  echo ""
  
  # Build file map for each issue
  unset issue_files issue_blocked
  declare -A issue_files
  declare -A issue_blocked
  issues_array=()

  while IFS= read -r issue; do
    [ -z "$issue" ] && continue
    issues_array+=("$issue")
  done <<< "$available_issues"

  for issue in "${issues_array[@]}"; do
    echo "Analyzing issue #$issue..."
    
    # Fetch issue body separately to avoid JSON parsing issues
    issue_body=$(gh issue view "$issue" --json body --jq '.body' 2>/dev/null || echo "")
    
    if [ -z "$issue_body" ]; then
      echo "  Warning: Could not fetch body for issue #$issue"
      continue
    fi
    
    # Parse files
    existing_files=$(parse_files "$issue_body" "Existing files to modify")
    new_files=$(parse_files "$issue_body" "New files")
    all_files=$(printf '%s\n%s\n' "$existing_files" "$new_files" | awk 'NF')
    issue_files["$issue"]="$all_files"
    
    # Check if blocked
    if is_blocked "$issue_body"; then
      issue_blocked["$issue"]=1
      echo "  Issue #$issue is blocked"
    else
      issue_blocked["$issue"]=0
      echo "  Issue #$issue is ready"
      echo "  Files: $all_files"
    fi
  done
  
  echo ""
  echo "Finding parallel issues..."
  
  # Find issues that can run in parallel
  parallel_issues=()
  for issue in "${issues_array[@]}"; do
    # Skip if blocked
    if [ "${issue_blocked[$issue]:-0}" = "1" ]; then
      continue
    fi
    
    # Check if this issue conflicts with any already selected
    conflict=false
    for selected in "${parallel_issues[@]}"; do
      if files_overlap "${issue_files[$issue]:-}" "${issue_files[$selected]:-}"; then
        echo "  Issue #$issue conflicts with #$selected (shared files)"
        conflict=true
        break
      fi
    done
    
    if ! $conflict; then
      parallel_issues+=("$issue")
      echo "  Issue #$issue can run in parallel"
    fi
  done
  
  if [ ${#parallel_issues[@]} -eq 0 ]; then
    final_state="blocked"
    final_details=$(format_issue_list "$available_issues")
    echo "No parallel issues found. Open child issues are blocked or conflict with each other: $final_details"
    break
  fi
  
  echo ""
  echo "Running ${#parallel_issues[@]} issue(s) in parallel: ${parallel_issues[*]}"
  
  if $dry_run; then
    echo "[DRY RUN] Would spawn agents for: ${parallel_issues[*]}"
    echo ""
    echo "Dry run complete. Exiting."
    final_state="dry-run"
    final_details="${parallel_issues[*]}"
    break
  fi
  
  # Spawn agents in parallel (each capped at AGENT_TIMEOUT seconds)
  pids=()
  for issue in "${parallel_issues[@]}"; do
    echo "  Spawning agent for issue #$issue (timeout: ${AGENT_TIMEOUT}s)"
    timeout "$AGENT_TIMEOUT" "$agent_once" "$issue" &
    pids+=("$!")
  done
  
  # Wait for all agents to complete
  echo ""
  echo "Waiting for ${#pids[@]} agent(s) to complete..."
  failed=0
  for pid in "${pids[@]}"; do
    if ! wait "$pid"; then
      echo "  Agent failed (pid $pid)"
      failed=$((failed + 1))
    fi
  done
  
  if [ $failed -gt 0 ]; then
    echo ""
    echo "Warning: $failed agent(s) failed"
  fi
  
  iteration=$((iteration + 1))
done

echo ""
echo "========================================"
case "$final_state" in
  complete)
    echo "All child issues complete!"
    exit_code=0
    ;;
  dry-run)
    echo "Dry run complete. Ready issues: ${final_details}"
    exit_code=0
    ;;
  failed)
    echo "Open failed child issues remain: ${final_details}"
    exit_code=1
    ;;
  in-progress)
    echo "Open in-progress child issues remain: ${final_details}"
    exit_code=2
    ;;
  blocked)
    echo "Open child issues remain but none are schedulable: ${final_details}"
    exit_code=3
    ;;
  *)
    echo "Finished with unknown state."
    exit_code=1
    ;;
esac
echo "Finished: $(date '+%H:%M:%S')"
echo "========================================"
exit "$exit_code"
